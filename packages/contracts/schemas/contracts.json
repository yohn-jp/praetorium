              },
              {
                "type": "null"
              }
            ]
          },
          "activeApiRequests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "activeMcpRequests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "activeMutations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "activeJobs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "restartableJobs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "pendingCheckpoints": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
