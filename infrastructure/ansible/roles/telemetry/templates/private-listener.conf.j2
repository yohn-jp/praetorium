[Service]
ExecStart=
ExecStart=/usr/bin/prometheus-node-exporter --web.listen-address={{ telemetry_listen_address }}:{{ telemetry_exporter_port }}{% if telemetry_systemd_units | length > 0 %} --collector.disable-defaults --collector.cpu --collector.meminfo --collector.filesystem --collector.systemd --collector.systemd.unit-include={{ ('^(' ~ (telemetry_systemd_units | map('replace', '.', '[.]') | join('|')) ~ ')$') | quote }}{% endif %}
