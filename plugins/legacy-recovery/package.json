{
  "name": "@praetorium/legacy-recovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/recovery.d.ts",
      "import": "./dist/recovery.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm run typecheck && pnpm run test",
    "lint": "eslint . --max-warnings 0",
    "recovery": "node --experimental-strip-types src/cli.ts",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
