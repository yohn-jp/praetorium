        "additionalProperties": false
      },
      "attemptId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "attempt": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "leaseEpoch": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "leaseToken": {
        "type": "string",
        "minLength": 32,
        "maxLength": 256
      },
      "leaseExpiresAt": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "buildId",
      "buildKey",
      "input",
      "attemptId",
      "attempt",
      "leaseEpoch",
      "leaseToken",
      "leaseExpiresAt"
