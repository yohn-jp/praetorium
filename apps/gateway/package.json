{
  "name": "@praetorium/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "node ../../scripts/clean-workspace.mjs",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "dev:build": "tsc -p tsconfig.json --watch",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@praetorium/auth": "workspace:*",
    "@praetorium/config": "workspace:*",
    "@praetorium/contracts": "workspace:*",
    "@praetorium/domain": "workspace:*",
    "@praetorium/github": "workspace:*",
    "hono": "4.12.33",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260801.1",
    "wrangler": "4.118.0"
  }
}
