{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "praetorium-control-plane",
  "main": "../../apps/control-plane/src/worker.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "CONTROL_PLANE_DB",
      "database_name": "praetorium-platform",
      "database_id": "@@CONTROL_PLANE_DATABASE_ID@@",
      "migrations_dir": "../../apps/control-plane/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPOSITORY_COORDINATOR",
        "class_name": "RepositoryCoordinator"
      }
    ]
  },
  "services": [
    {
      "binding": "GATEWAY_SERVICE",
      "service": "praetorium-gateway"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RepositoryCoordinator"]
    }
  ],
  "vars": {
    "BUILD_POLICY_JSON": "@@BUILD_POLICY_JSON@@",
    "BUILD_WORKER_ID": "@@BUILD_WORKER_ID@@",
    "CONTROL_PLANE_ORIGIN": "@@CONTROL_PLANE_ORIGIN@@",
    "GATEWAY_ORIGIN": "@@GATEWAY_ORIGIN@@",
    "INSTANCE_HOST_SUFFIX": "@@INSTANCE_HOST_SUFFIX@@",
    "PROVISIONER_WORK_NOTIFICATION_URL": "@@PROVISIONER_WORK_NOTIFICATION_URL@@",
    "BUILD_WORK_NOTIFICATION_URL": "@@BUILD_WORK_NOTIFICATION_URL@@",
    "RELEASE_POLICY_JSON": "@@RELEASE_POLICY_JSON@@",
    "RUNTIME_REGISTRY_HOST": "@@RUNTIME_REGISTRY_HOST@@"
  }
}
