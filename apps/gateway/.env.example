# Non-secret deployment values. Replace the hostnames with owned DNS names.
GATEWAY_ENVIRONMENT=development
GATEWAY_ORIGIN=https://gateway.praetorium.example
GATEWAY_INSTANCE_HOSTNAME_SUFFIX=instances.praetorium.example
GATEWAY_ALLOWED_REPOSITORY_OWNER=praetorium

# Lifetimes are bounded and parsed during Worker request composition.
GATEWAY_SESSION_TTL_SECONDS=43200
GATEWAY_HANDOFF_TTL_SECONDS=60
GATEWAY_ACCESS_GRANT_TTL_SECONDS=300

# GitHub App user authorization. App ID and OAuth values are Wrangler secrets
# in deployed environments; set local development values through .dev.vars.
GITHUB_APP_ID=123456
GITHUB_OAUTH_CLIENT_ID=Iv1.replace-me
GITHUB_OAUTH_CLIENT_SECRET=replace-with-secret

# Required secret values. Use strong independent random values for each
# pepper. Token encryption key is 32 random bytes encoded as base64url. The
# signing secret is JSON: {"kid":"...","privateKeyJwk":{...P-256 private JWK...}}.
GATEWAY_SESSION_DIGEST_PEPPER=replace-with-independent-random-secret
GATEWAY_CREDENTIAL_DIGEST_PEPPER=replace-with-independent-random-secret
GATEWAY_HANDOFF_DIGEST_PEPPER=replace-with-independent-random-secret
GATEWAY_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
GATEWAY_TOKEN_ENCRYPTION_KEY_ID=token-key-2026-01
GATEWAY_SIGNING_KEY=replace-with-private-p256-jwk-json

# Shared service credentials. Use distinct random values and set each on both
# communicating services. These are secrets in deployed environments.
CONTROL_PLANE_GATEWAY_AUTH=replace-with-control-plane-shared-secret
INSTANCE_ACCESS_SERVICE_AUTH_TOKEN=replace-with-instance-access-shared-secret

# Wrangler bindings are declared in wrangler.toml:
# USER_AUTH_STATE, EPHEMERAL_CODES, GATEWAY_KV, CONTROL_PLANE.
