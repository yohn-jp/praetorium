{
  "AccessGrantSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "iss": {
        "type": "string",
        "format": "uri"
      },
      "sub": {
        "type": "string",
        "minLength": 1
      },
      "aud": {
        "type": "string",
        "format": "uri"
      },
      "instanceId": {
        "type": "string",
        "minLength": 1
      },
      "repositoryId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "runtimeEpoch": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "permissions": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "read",
            "write",
            "maintain",
            "admin"
          ]
        }
      },
      "sessionRevision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "authorizationRevision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "iat": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "nbf": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "exp": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "jti": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "iss",
      "sub",
      "aud",
      "instanceId",
      "repositoryId",
      "runtimeEpoch",
      "permissions",
      "sessionRevision",
      "authorizationRevision",
      "iat",
      "nbf",
      "exp",
      "jti"
    ],
    "additionalProperties": false
  },
  "BuildCandidateSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "candidateRef": {
        "type": "string",
        "pattern": "^[a-z0-9./:_-]+@sha256:[a-f0-9]{64}$"
      },
      "manifestDigest": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "required": [
      "candidateRef",
      "manifestDigest"
    ],
    "additionalProperties": false
  },
  "BuildCatalogSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "contractVersion": {
        "type": "string",
        "const": "scriptorium-build/v1"
      },
      "producerRevision": {
        "type": "string",
        "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
      },
      "runtimeBaseDigest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "buildKitDigest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "recipeDigest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "lockDigest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "sourceDigest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "supportedPlatforms": {
        "minItems": 1,
        "maxItems": 32,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,31}\\/[a-z0-9][a-z0-9._-]{0,31}$"
        }
      },
      "modules": {
        "maxItems": 256,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "artifactDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "requires": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "conflicts": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "contractRange": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "exclusiveResources": {
              "type": "object",
              "properties": {
                "cpuMilli": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "memoryMiB": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "ephemeralStorageMiB": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "cpuMilli",
                "memoryMiB",
                "ephemeralStorageMiB"
              ],
              "additionalProperties": false
            },
            "sharedResourceGroupIds": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "workerLimits": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]{0,63}$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "required": [
            "id",
            "version",
            "artifactDigest",
            "requires",
            "conflicts",
            "contractRange",
            "exclusiveResources",
            "sharedResourceGroupIds",
            "workerLimits"
          ],
          "additionalProperties": false
        }
      },
      "baseResources": {
        "type": "object",
        "properties": {
          "cpuMilli": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "memoryMiB": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "ephemeralStorageMiB": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "cpuMilli",
          "memoryMiB",
          "ephemeralStorageMiB"
        ],
        "additionalProperties": false
      },
      "sharedResourceGroups": {
        "maxItems": 256,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "resources": {
              "type": "object",
              "properties": {
                "cpuMilli": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "memoryMiB": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "ephemeralStorageMiB": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "cpuMilli",
                "memoryMiB",
                "ephemeralStorageMiB"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "resources"
          ],
          "additionalProperties": false
        }
      },
      "resourceProfiles": {
        "maxItems": 256,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "cpuMilli": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "memoryMiB": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "ephemeralStorageMiB": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "cpuMilli",
            "memoryMiB",
            "ephemeralStorageMiB"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "contractVersion",
      "producerRevision",
      "runtimeBaseDigest",
      "buildKitDigest",
      "recipeDigest",
      "lockDigest",
      "sourceDigest",
      "supportedPlatforms",
      "modules",
      "baseResources",
      "sharedResourceGroups",
      "resourceProfiles"
    ],
    "additionalProperties": false
  },
