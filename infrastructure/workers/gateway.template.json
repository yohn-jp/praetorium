{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "praetorium-gateway",
  "main": "../../apps/gateway/src/worker.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "ratelimits": [
    { "name": "LOGIN_RATE_LIMIT", "namespace_id": "761101", "simple": { "limit": 10, "period": 60 } },
    { "name": "MCP_SOURCE_RATE_LIMIT", "namespace_id": "761102", "simple": { "limit": 60, "period": 60 } },
    { "name": "MCP_CREDENTIAL_RATE_LIMIT", "namespace_id": "761103", "simple": { "limit": 20, "period": 60 } },
    { "name": "RUNTIME_GIT_RATE_LIMIT", "namespace_id": "761104", "simple": { "limit": 120, "period": 60 } },
    { "name": "WAKE_RATE_LIMIT", "namespace_id": "761105", "simple": { "limit": 10, "period": 60 } },
    { "name": "MUTATION_RECEIPT_RATE_LIMIT", "namespace_id": "761106", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_AUTH_STATE",
        "class_name": "UserAuthStateDurableObject"
      },
      {
        "name": "EPHEMERAL_CODES",
        "class_name": "EphemeralCodeDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserAuthStateDurableObject", "EphemeralCodeDurableObject"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "GATEWAY_KV",
      "id": "@@GATEWAY_KV_NAMESPACE_ID@@",
      "preview_id": "@@GATEWAY_KV_NAMESPACE_ID@@"
    }
  ],
  "services": [
    {
      "binding": "CONTROL_PLANE",
      "service": "praetorium-control-plane"
    }
  ],
  "vars": {
    "GATEWAY_ORIGIN": "@@GATEWAY_ORIGIN@@",
    "CONTROL_PLANE_ORIGIN": "@@CONTROL_PLANE_ORIGIN@@",
    "GATEWAY_SESSION_TTL_SECONDS": "28800",
    "GATEWAY_HANDOFF_TTL_SECONDS": "60",
    "GATEWAY_ACCESS_GRANT_TTL_SECONDS": "300",
    "GATEWAY_INSTANCE_HOSTNAME_SUFFIX": "@@GATEWAY_INSTANCE_HOSTNAME_SUFFIX@@",
    "GATEWAY_ALLOWED_REPOSITORY_OWNER": "@@GATEWAY_ALLOWED_REPOSITORY_OWNER@@",
    "GITHUB_APP_ID": "@@GITHUB_APP_ID@@",
    "GITHUB_OAUTH_CLIENT_ID": "@@GITHUB_OAUTH_CLIENT_ID@@",
    "GATEWAY_TOKEN_ENCRYPTION_KEY_ID": "@@GATEWAY_TOKEN_ENCRYPTION_KEY_ID@@"
  }
}
