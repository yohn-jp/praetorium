        "maximum": 9007199254740991
      },
      "quiesceRevision": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "disposition": {
        "type": "string",
        "enum": [
          "safe",
          "blocked",
          "unknown"
        ]
      },
      "activeMutations": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "activeJobs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "restartableJobs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "pendingCheckpoints": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "uncertainPublication": {
        "type": "boolean"
      },
      "lastConfirmedRemoteRevision": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          {
            "type": "null"
          }
        ]
      },
      "reasonCodes": {
        "maxItems": 64,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        }
      },
      "observedAt": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
      }
    },
    "required": [
      "contractVersion",
      "operationId",
      "instanceId",
      "runtimeEpoch",
      "quiesceRevision",
      "disposition",
      "activeMutations",
      "activeJobs",
      "restartableJobs",
      "pendingCheckpoints",
      "uncertainPublication",
      "lastConfirmedRemoteRevision",
      "reasonCodes",
      "observedAt"
    ],
    "additionalProperties": false
  },
