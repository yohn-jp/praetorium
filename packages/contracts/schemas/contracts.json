  "QuiesceRequestSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "contractVersion": {
        "type": "string",
        "const": "scriptorium-platform/v1"
      },
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "instanceId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "runtimeEpoch": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "deadline": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
      }
    },
    "required": [
      "contractVersion",
      "operationId",
      "instanceId",
      "runtimeEpoch",
      "reason",
      "deadline"
    ],
    "additionalProperties": false
  },
  "QuiesceResultSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "contractVersion": {
        "type": "string",
        "const": "scriptorium-platform/v1"
      },
