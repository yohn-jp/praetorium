{
  "name": "@praetorium/ghcr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/oci-registry-client.d.ts",
      "import": "./dist/oci-registry-client.js"
    },
    "./builder-signature": {
      "types": "./dist/builder-signature.d.ts",
      "import": "./dist/builder-signature.js"
    },
    "./provenance": {
      "types": "./dist/sigstore-provenance.d.ts",
      "import": "./dist/sigstore-provenance.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@praetorium/contracts": "workspace:*",
    "@sigstore/bundle": "4.0.0",
    "@sigstore/protobuf-specs": "0.5.1",
    "@sigstore/verify": "4.1.0"
  },
  "devDependencies": {
    "@sigstore/core": "4.0.1",
    "@types/node": "24.19.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
