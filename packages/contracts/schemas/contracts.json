{
  "AccessGrantSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "iss": {
        "type": "string",
        "format": "uri"
      },
      "sub": {
        "type": "string",
        "minLength": 1
      },
      "aud": {
        "type": "string",
        "format": "uri"
      },
      "instanceId": {
        "type": "string",
        "minLength": 1
      },
      "repositoryId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "runtimeEpoch": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "permissions": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["read", "write", "maintain", "admin"]
        }
      },
      "sessionRevision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "authorizationRevision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "iat": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "nbf": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "exp": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "jti": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "iss",
      "sub",
      "aud",
      "instanceId",
      "repositoryId",
      "runtimeEpoch",
      "permissions",
      "sessionRevision",
      "authorizationRevision",
      "iat",
      "nbf",
      "exp",
      "jti"
    ],
    "additionalProperties": false
  },
  "BuildInputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "contractVersion": {
        "type": "string",
        "const": "scriptorium-build/v1"
      },
      "producerRevision": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "runtimeBaseDigest": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "buildKitDigest": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "recipeDigest": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "sourceDigest": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "lockDigest": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "requestedModules": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "resolvedModules": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "artifactDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": ["id", "version", "artifactDigest"],
          "additionalProperties": false
        }
      },
      "platform": {
        "type": "string",
        "enum": ["linux/amd64", "linux/arm64"]
      },
      "options": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "required": [
      "contractVersion",
      "producerRevision",
      "runtimeBaseDigest",
      "buildKitDigest",
      "recipeDigest",
      "sourceDigest",
      "lockDigest",
      "requestedModules",
      "resolvedModules",
      "platform",
      "options"
    ],
    "additionalProperties": false
  },
  "DigestSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "string",
    "pattern": "^sha256:[a-f0-9]{64}$"
  },
  "LogicalInstanceSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "instanceId": {
        "type": "string",
        "minLength": 1
      },
      "repositoryId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "generation": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "runtimeEpoch": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "desiredState": {
        "type": "string",
        "enum": ["running", "stopped"]
      },
      "policy": {
        "type": "string",
        "enum": ["stable", "pinned"]
      },
      "observedGeneration": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "currentArtifactDigest": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "desiredArtifactDigest": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "instanceId",
      "repositoryId",
      "generation",
      "runtimeEpoch",
      "desiredState",
      "policy",
      "observedGeneration",
      "currentArtifactDigest",
      "desiredArtifactDigest"
    ],
    "additionalProperties": false
  },
  "OperationSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "instanceId": {
        "type": "string",
        "minLength": 1
      },
      "generation": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "runtimeEpoch": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "kind": {
        "type": "string",
        "enum": ["start", "stop", "redeploy", "update"]
      },
      "status": {
        "type": "string",
        "enum": ["pending", "claimed", "running", "succeeded", "failed", "blocked"]
      },
      "attempt": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "leaseEpoch": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "reportSequence": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "leaseExpiresAt": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "id",
      "instanceId",
      "generation",
      "runtimeEpoch",
      "kind",
      "status",
      "attempt",
      "leaseEpoch",
      "reportSequence",
      "leaseExpiresAt"
    ],
    "additionalProperties": false
  },
  "PermissionSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "string",
    "enum": ["read", "write", "maintain", "admin"]
  },
  "RepositoryBindingSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "repositoryId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "instanceId": {
        "type": "string",
        "minLength": 1
      },
      "installationId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "owner": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "authorizationRevision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "suspended": {
        "type": "boolean"
      }
    },
    "required": [
      "repositoryId",
      "instanceId",
      "installationId",
      "owner",
      "name",
      "authorizationRevision",
      "suspended"
    ],
    "additionalProperties": false
  },
  "RepositoryIdSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "integer",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991
  },
  "ResourceRequirementsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "cpuMilli": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "memoryMiB": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "ephemeralStorageMiB": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": ["cpuMilli", "memoryMiB", "ephemeralStorageMiB"],
    "additionalProperties": false
  }
}
